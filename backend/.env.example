# AI Career Copilot — Backend Environment Configuration

# Security
SECRET_KEY=your-super-secret-key-change-in-production-2026

# Database (defaults to SQLite if not provided, or PostgreSQL e.g. postgresql://user:pass@host/dbname)
DATABASE_URL=sqlite:///./career_copilot.db

# LLM Provider: gemini | openai | claude | local
LLM_PROVIDER=gemini

# AI API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
